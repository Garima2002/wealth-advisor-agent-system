# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# CRM Integration (Mock / Adapter)
CRM_TIMEOUT_SECONDS=2.0
CRM_MAX_RETRIES=3
CRM_RETRY_BACKOFF_FACTOR=0.2

# Anomaly Detection Configurable Thresholds
ANOMALY_LARGE_TX_THRESHOLD=5000.0
ANOMALY_CATEGORY_MULTIPLIER=3.0
ANOMALY_CATEGORY_MIN_SAMPLES=3
ANOMALY_SPENDING_SPIKE_RATIO=1.5
ANOMALY_DUPLICATE_WINDOW_HOURS=48
PORTFOLIO_CONCENTRATION_THRESHOLD=0.60

# Persistence & Storage
SQLITE_DB_PATH=wealth_advisor.db
RETENTION_DAYS=90
MAX_HISTORICAL_RECORDS_PER_CLIENT=50
